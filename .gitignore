.env
.env.*
!.env.example

# Android / TWA.
#
# The generated Gradle project IS committed — `bubblewrap init` is
# interactive, so CI has no way to recreate it and can only run `update` +
# `build` against something that already exists. What is ignored below is
# build output, machine-local paths and signing material.
android/build
android/app/build
android/.gradle
android/local.properties
android/*.aab
android/*.apk
android/*.idsig

# Signing material — a committed key cannot be un-committed
*.jks
*.keystore

