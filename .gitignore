# Local env files
.env
.env.*
!.env.example

# Android / TWA.
#
# The generated Gradle project IS committed — `bubblewrap init` is
# interactive, so CI has no way to recreate it and can only run `update` +
# `build` against something that already exists. What is ignored below is
# build output, machine-local paths and signing material.
android/build
android/app/build
android/.gradle
android/local.properties
android/*.aab
android/*.apk
android/*.idsig

# Signing material — a committed key cannot be un-committed
*.jks
*.keystore

# Play Store listing artwork. The icon and feature graphic ARE committed —
# small, stable, and wanted at every listing edit. Screenshots are not: they
# are bulky, they change with every visual tweak, and `bun run
# play:screenshots` regenerates all 24 in about a minute.
play-assets/screenshots/
