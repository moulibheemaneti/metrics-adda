{
   "name": "metrics-adda",
   "version": "1.23.1",
   "type": "module",
   "private": true,
   "homepage": "https://www.metricsadda.com",
   "scripts": {
      "build": "bun --bun nuxt build",
      "dev": "bun --bun nuxt dev",
      "generate": "bun --bun nuxt generate",
      "preview": "bun --bun nuxt preview",
      "postinstall": "bun --bun nuxt prepare",
      "prepare": "commitguard install",
      "lint": "bunx --bun stylelint '**/*.scss'; bunx --bun eslint .",
      "lint:fix": "bunx --bun stylelint --fix '**/*.scss'; bunx --bun eslint . --fix",
      "clean": "rm -rf .nuxt .output dist",
      "clean:all": "bun clean && rm -rf bun.lock",
      "typecheck": "vue-tsc --build --noEmit",
      "seo:verify": "bash scripts/seo/verify.sh",
      "seo:lighthouse": "bash scripts/seo/lighthouse.sh",
      "pwa:verify": "bash scripts/pwa/verify.sh",
      "play:assets": "bun --bun scripts/play/assets.mjs",
      "play:screenshots": "bun --bun scripts/play/screenshots.mjs",
      "test": "bunx --bun vitest run",
      "test:watch": "bunx --bun vitest"
   },
   "dependencies": {
      "@nuxt/eslint": "1.17.0",
      "@vercel/analytics": "^2.0.1",
      "@vercel/speed-insights": "^2.0.0",
      "eslint": "^10.13.0",
      "nuxt": "^4.6.2",
      "vue": "^3.5.44",
      "vue-router": "^5.4.0"
   },
   "devDependencies": {
      "@moulibheemaneti/commitguard": "^0.1.4",
      "@nuxt/fonts": "^1.0.1",
      "@nuxt/image": "^2.2.0",
      "@nuxt/test-utils": "^4.3.4",
      "@nuxtjs/seo": "^5.3.16",
      "@resvg/resvg-js": "^2.6.2",
      "@semantic-release/changelog": "^7.0.0",
      "@semantic-release/commit-analyzer": "^13.0.1",
      "@semantic-release/git": "^11.0.1",
      "@semantic-release/github": "^12.0.10",
      "@semantic-release/npm": "^13.2.0",
      "@semantic-release/release-notes-generator": "^14.1.1",
      "@stylistic/stylelint-plugin": "^5.3.1",
      "@vite-pwa/nuxt": "^1.1.1",
      "@vue/test-utils": "^2.5.1",
      "conventional-changelog-conventionalcommits": "^9.3.1",
      "happy-dom": "^21.0.3",
      "sass": "^1.105.2",
      "sass-embedded": "^1.105.2",
      "sass-true": "^10.1.0",
      "satori": "^0.63.0",
      "semantic-release": "^25.0.9",
      "stylelint": "^17.16.0",
      "stylelint-config-standard": "^40.0.0",
      "stylelint-config-standard-scss": "^17.0.0",
      "typescript": "^6.0.3",
      "vitest": "^5.0.5",
      "vue-tsc": "^3.3.13"
   }
}
