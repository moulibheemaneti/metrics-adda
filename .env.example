# Canonical site URL used by Nuxt SEO (sitemap, robots, canonical, OG).
# Vercel sets this per-deploy; keep the production value here as the default.
NUXT_SITE_URL=https://www.metricsadda.com

# Stable secret for signing OG image URLs. Without it, nuxt-og-image
# auto-generates a new secret each build, so previously-cached social preview
# URLs break after a redeploy. Generate one with:
#   bunx nuxt-og-image generate-secret
# Set the real value in Vercel env (Production/Preview) — never commit it.
NUXT_OG_IMAGE_SECRET=
