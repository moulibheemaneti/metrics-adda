# Canonical site URL used by Nuxt SEO (sitemap, robots, canonical, OG).
# Vercel sets this per-deploy; keep the production value here as the default.
NUXT_SITE_URL=https://www.metricsadda.com

# Stable secret for signing OG image URLs. Without it, nuxt-og-image
# auto-generates a new secret each build, so previously-cached social preview
# URLs break after a redeploy. Generate one with:
#   bunx nuxt-og-image generate-secret
# Set the real value in Vercel env (Production/Preview) — never commit it.
NUXT_OG_IMAGE_SECRET=

# Google AdSense, read by `components/AdSlot.vue`. Leave BOTH empty to turn
# ads off completely — no <ins>, no adsbygoogle.js, no third-party request.
# That is the intended state locally and in CI, so Lighthouse measures the
# site rather than the ad auction. Set them in Vercel env (Production only)
# once the AdSense account is approved.
#
# The publisher ID, with the "ca-" prefix: ca-pub-XXXXXXXXXXXXXXXX.
# Note `public/ads.txt` needs the same ID without the prefix.
NUXT_PUBLIC_ADSENSE_CLIENT=
# The ad unit's slot ID from the AdSense console — digits only.
NUXT_PUBLIC_ADSENSE_SLOT_FOOTER=
